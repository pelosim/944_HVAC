# ── Dependencies (huge, auto-installed by npm) ──
dashboard/node_modules/

# ── Build output (auto-generated by npm run build) ──
dashboard/build/

# ── Runtime state (device-specific, not code) ──
hvac_state.json

# ── Python cache ──
__pycache__/
*.pyc
*.pyo

# ── OS junk ──
.DS_Store
Thumbs.db

# ── Editor files ──
*.swp
*~
.vscode/

# ── Hand-made "before I changed it" snapshots on the Pi ──
# Kept deliberately, but git history is the real record and they only ever
# showed up as untracked noise in `git status`. Not deleted — they are the
# author's own backups.
*.prestatus

# ── Logs ──
*.log
